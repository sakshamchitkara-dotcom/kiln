# Claude API key. Leave empty to run Kiln in offline "scripted" mode.
ANTHROPIC_API_KEY=
# Force the offline scripted generator even when a key is set (true/false).
KILN_SCRIPTED=false
# Model used for generation.
KILN_MODEL=claude-opus-5-5
# API port and where sqlite + build artifacts live.
PORT=8787
KILN_DATA_DIR=./data
# Optional: deploy built sites to Vercel.
VERCEL_TOKEN=
# Optional: push generated projects to GitHub repos you own (opt-in per push).
GITHUB_TOKEN=
